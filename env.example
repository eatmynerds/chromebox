# cp env.example .env
# every SSH_PUBLIC_KEY* gets added to all nodes
SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAREPLACE_ME you@desktop"
# SSH_PUBLIC_KEY_LAPTOP="ssh-ed25519 AAAA... you@laptop"

# optional, console login only
USER_PASSWORD=""

# optional, portainer admin password (12+ chars)
PORTAINER_ADMIN_PASSWORD=""
